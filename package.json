{
  "name": "nexttern",
  "version": "0.1.0",
  "private": true,
  "description": "Human-First Talent Discovery Platform",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:app": "npm run dev --workspace=app",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "build:app": "npm run build --workspace=app",
    "build:server": "npm run build --workspace=server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit --project app/tsconfig.json && tsc --noEmit --project server/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexttern/nexttern.git"
  },
  "keywords": [
    "talent",
    "discovery",
    "internship",
    "recruitment",
    "matching"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.3"
  }
}
